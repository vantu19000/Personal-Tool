# ==========================================
# Cấu hình Server App
# ==========================================
PORT=9981

# ==========================================
# Cấu hình MongoDB Database (Docker)
# ==========================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=rootpassword
MONGO_DB_NAME=personal_tool_db
MONGO_AUTH_SOURCE=admin

# (Tùy chọn) Chuỗi kết nối URI trực tiếp nếu muốn ghi đè cấu hình trên:
# MONGO_URI=mongodb://root:rootpassword@localhost:27017/personal_tool_db?authSource=admin
