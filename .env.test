# ==========================================
# Cấu hình Môi trường TEST (Tách biệt hoàn toàn)
# Chạy trên port 9982 và database personal_tool_test_db
# ==========================================
PORT=9982
APP_ENV=testing

# Cấu hình MongoDB Database Test
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=rootpassword
MONGO_DB_NAME=personal_tool_test_db
MONGO_AUTH_SOURCE=admin

# Chuỗi kết nối URI Test:
# mongodb://root:rootpassword@localhost:27017/personal_tool_test_db?authSource=admin
